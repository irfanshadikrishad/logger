{
  "name": "@irfanshadikrishad/logger",
  "description": "Standardised, colourised, class-based logger for Node.js: one consistent log format across all your projects.",
  "version": "0.1.1",
  "author": "irfanshadikrishad (https://www.irfanshadikrishad.dev)",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "bump:major": "npm version major -m \"chore(release): v%s\"",
    "bump:minor": "npm version minor -m \"chore(release): v%s\"",
    "bump:patch": "npm version patch -m \"chore(release): v%s\"",
    "clean": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "format": "prettier ./ --write",
    "format:check": "prettier ./ --write --check",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json"
  },
  "keywords": [
    "logger",
    "logging",
    "chalk",
    "console",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanshadikrishad/logger.git"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "prettier": "@irfanshadikrishad/prettier",
  "dependencies": {
    "chalk": "^6.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@irfanshadikrishad/prettier": "^1.3.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
