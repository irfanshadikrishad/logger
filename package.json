{
  "name": "@irfanshadikrishad/logger",
  "version": "0.1.0",
  "description": "Standardised, colourised, class-based logger for Node.js: one consistent log format across all your projects.",
  "keywords": [
    "logger",
    "logging",
    "chalk",
    "console",
    "typescript",
    "esm"
  ],
  "license": "MIT",
  "author": "irfanshadikrishad (https://www.irfanshadikrishad.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanshadikrishad/logger.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chalk": "^6.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10",
    "typescript": "^5.9.3"
  }
}
